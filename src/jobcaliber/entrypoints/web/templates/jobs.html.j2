{% extends "base.html.j2" %}
{% macro filter_field(row) %}
  {% set id = 'filter-' ~ row.column.key|replace(':', '-') %}
  <div class="field field-{{ row.column.kind }}">
    <label for="{{ id }}">{{ row.column.label }}</label>
    {% if row.column.kind == 'number' %}
      <select name="op__{{ row.column.key }}" title="comparison">
        {% for op in row.column.ops %}
          <option value="{{ op }}" {% if op == row.op %}selected{% endif %}>{{ operators.get(op, op) }}</option>
        {% endfor %}
      </select>
    {% endif %}
    {% if row.column.key == 'decision' %}
      <span class="checks">
        {% for option in row.column.options %}
          <label class="inline"><input type="checkbox" name="decisions" value="{{ option }}"
            {% if option in row.value %}checked{% endif %}> {{ option }}</label>
        {% endfor %}
      </span>
    {% elif row.column.kind == 'enum' %}
      <select id="{{ id }}" name="val__{{ row.column.key }}">
        <option value="">any</option>
        {% for option in row.column.options %}
          <option value="{{ option }}" {% if option in row.value %}selected{% endif %}>{{ row.column.option_labels.get(option, option) }}</option>
        {% endfor %}
      </select>
    {% else %}
      <input id="{{ id }}" type="{{ 'date' if row.column.kind == 'date' else 'search' }}"
             name="val__{{ row.column.key }}" placeholder="any" value="{{ row.shown }}">
    {% endif %}
  </div>
{% endmacro %}


{% block title %}Jobs · jobcaliber{% endblock %}
{% block content %}
<form method="get" action="/jobs" class="filters-form">
  <details class="filters">
    <summary>
      <span class="title">Filters</span>
      <span class="chips">
        <span class="chip">decision: {{ filters.decisions|join(', ') }}</span>
        {%- for row in filters.rows if row.shown and row.column.key != 'decision' %}
          <span class="chip">{{ row.column.label }} {{ operators.get(row.op, row.op) }} {{ row.shown }}</span>
        {%- endfor %}
        {%- if filters.exclude_missing %}<span class="chip">without “cannot tell”</span>{% endif %}
      </span>
    </summary>

    <div class="panel">
      <fieldset class="subbox">
        <legend>Show columns</legend>
        <div class="cols-row">
          {% for column in filters.selectable_columns %}
            <label class="inline"><input type="checkbox" name="cols" value="{{ column }}"
              {% if column in visible %}checked{% endif %}> {{ column }}</label>
          {% endfor %}
        </div>
      </fieldset>

      {% for title, rows in filters.groups %}
        <fieldset class="subbox">
          <legend>{{ title }}</legend>
          <div class="filter-fields">
            {% for row in rows %}{{ filter_field(row) }}{% endfor %}
          </div>
        </fieldset>
      {% endfor %}
      <div class="row">
        <label class="inline" title="Hide offers where the model could not judge at least one criterion">
          <input type="checkbox" name="exclude_missing" value="1" {% if filters.exclude_missing %}checked{% endif %}>
          remove “cannot tell”
        </label>
      </div>
      <div class="actions">
        <input type="hidden" name="sort" value="{{ filters.sort }}">
        <input type="hidden" name="dir" value="{{ filters.dir }}">
        <button type="submit">Apply</button>
        <a href="/">Reset</a>
      </div>
    </div>
  </details>
</form>

<p class="count">{{ table.total }} offers · {{ table.offset + 1 }}–{{ table.offset + table.rows|length }}</p>

<table>
  <thead>
    <tr>
      <th><a href="{{ jobs_url(filters, sort='score_total', dir='asc' if filters.sort == 'score_total' and filters.dir == 'desc' else 'desc') }}">Score</a></th>
      <th><a href="{{ jobs_url(filters, sort='decision', dir='asc' if filters.sort == 'decision' and filters.dir == 'desc' else 'desc') }}">Decision</a></th>
      <th><a href="{{ jobs_url(filters, sort='title', dir='asc' if filters.sort == 'title' and filters.dir == 'desc' else 'desc') }}">Title / company</a></th>
      <th><a href="{{ jobs_url(filters, sort='source', dir='asc' if filters.sort == 'source' and filters.dir == 'desc' else 'desc') }}">Board</a></th>
      <th>Ad location</th>
      {% for column in columns %}
        <th class="crit"><a href="{{ jobs_url(filters, sort='crit:' ~ column, dir='asc' if filters.sort == 'crit:' ~ column and filters.dir == 'desc' else 'desc') }}" title="criterion">{{ column }}</a></th>
      {% endfor %}
      {% if 'salary' in visible %}<th>Salary</th>{% endif %}
      {% if 'last_seen' in visible %}<th><a href="{{ jobs_url(filters, sort='last_seen_at', dir='asc' if filters.sort == 'last_seen_at' and filters.dir == 'desc' else 'desc') }}">Last seen</a></th>{% endif %}
      {% if 'run' in visible %}<th><a href="{{ jobs_url(filters, sort='run_started_at', dir='asc' if filters.sort == 'run_started_at' and filters.dir == 'desc' else 'desc') }}">Run</a></th>{% endif %}
      {% if 'status' in visible %}<th>Status</th>{% endif %}
    </tr>
  </thead>
  <tbody>
  {% for row in table.rows %}
    {% set job = row.job %}
    <tr class="{{ job.decision }}">
      <td class="score">{{ '%.1f'|format(job.score_total or 0) }}</td>
      <td><span class="badge {{ job.decision }}">{{ job.decision|upper }}</span></td>
      <td><a href="{{ detail_url(filters, job.id) }}">{{ job.title }}</a><br><small>{{ job.company }}</small></td>
      <td>{{ job.source }}</td>
      <td>{{ job.location_raw or '—' }}</td>
      {% for column in columns %}
        <td class="crit">
          {% if column in row.missing %}<em>—</em>
          {% elif row.answers.get(column) is number %}{{ '%.2f'|format(row.answers[column]) }}
          {% else %}{{ row.answers.get(column, '—') }}{% endif %}
        </td>
      {% endfor %}
      {% if 'salary' in visible %}
        <td>{% if job.salary_min or job.salary_max %}{{ job.salary_min or '?' }}–{{ job.salary_max or '?' }}{% else %}—{% endif %}</td>
      {% endif %}
      {% if 'last_seen' in visible %}<td><small>{{ job.last_seen_at|localtime }}</small></td>{% endif %}
      {% if 'run' in visible %}<td><small>{{ job.run_started_at|localtime }}</small></td>{% endif %}
      {% if 'status' in visible %}<td>{% set app = row.application %}{% if app %}<span class="app-{{ app.state }}">{{ app.state }}</span>{% else %}–{% endif %}</td>{% endif %}
    </tr>
  {% else %}
    <tr>
      <td colspan="{{ 5 + columns|length + (1 if 'salary' in visible else 0) + (1 if 'last_seen' in visible else 0) + (1 if 'run' in visible else 0) + (1 if 'status' in visible else 0) }}" class="empty">
        <strong>No results.</strong>
        <span class="active-filters">decisions: {{ filters.decisions|join(', ') or 'none' }}{% for row in filters.rows if row.shown and row.column.key != 'decision' %} · {{ row.column.label }} {{ operators.get(row.op, row.op) }} {{ row.shown }}{% endfor %}{% if filters.exclude_missing %} · without “cannot tell”{% endif %}</span>
        <a href="/jobs">Widen the search</a> ·
        <a href="/">reset the filters</a>.
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<p class="pager">
  {% if table.offset > 0 %}<a href="{{ jobs_url(filters, offset=table.offset - table.limit) }}">‹ previous</a>{% endif %}
  {% if table.offset + table.limit < table.total %}<a href="{{ jobs_url(filters, offset=table.offset + table.limit) }}">next ›</a>{% endif %}
</p>
{% endblock %}
