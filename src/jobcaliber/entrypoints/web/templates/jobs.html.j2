{% extends "base.html.j2" %}
{% block title %}Jobs · jobcaliber{% endblock %}
{% block content %}
<form method="get" action="/jobs" class="filters-form">
  <details class="filters">
    <summary>
      <span class="title">Filters</span>
      <span class="chips">
        {%- if filters.text %}<span class="chip">text: {{ filters.text }}</span>{% endif %}
        {%- if filters.location %}<span class="chip">location: {{ filters.location }}</span>{% endif %}
        {%- if filters.source %}<span class="chip">board: {{ filters.source }}</span>{% endif %}
        <span class="chip">decisions: {{ filters.decisions|join(', ') }}</span>
        {%- if filters.criterion %}<span class="chip">{{ filters.criterion }}{% if filters.option %} = {{ filters.option }}{% elif filters.value is not none %} {{ operators.get(filters.op, filters.op) }} {{ '%g'|format(filters.value) }}{% endif %}</span>{% endif %}
        {%- if filters.exclude_missing %}<span class="chip">without “cannot tell”</span>{% endif %}
        <span class="chip">run: {{ "every" if filters.run == 'all' else filters.run }}</span>
      </span>
    </summary>

    <div class="grid">
      <div class="stack">
      <fieldset class="card">
        <legend>Run</legend>
        <select name="run">
          <option value="all" {% if filters.run == 'all' %}selected{% endif %}>every run</option>
          {% for run in runs %}
            <option value="{{ run.id }}" {% if filters.run == run.id|string %}selected{% endif %}>
              {{ run.started_at }} · {{ run.status }} · {{ run.new }} new
            </option>
          {% endfor %}
        </select>
      </fieldset>

      <fieldset class="card">
        <legend>Text</legend>
        <label>Title or company
          <input type="search" name="q" value="{{ filters.text or '' }}" placeholder="python">
        </label>
        <label>Ad location
          <input type="search" name="location" value="{{ filters.location or '' }}" placeholder="Cagliari">
        </label>
      </fieldset>

      </div>

      <div class="stack">
      <fieldset class="card">
        <legend>Board</legend>
        <select name="source">
          <option value="">any</option>
          {% for board in sources %}
            <option value="{{ board }}" {% if board == filters.source %}selected{% endif %}>{{ board }}</option>
          {% endfor %}
        </select>
      </fieldset>

      <fieldset class="card">
        <legend>Decision</legend>
        <div class="row">
          {% for decision in decisions %}
            <label class="inline"><input type="checkbox" name="decisions" value="{{ decision }}"
              {% if decision in filters.decisions %}checked{% endif %}> {{ decision }}</label>
          {% endfor %}
        </div>
      </fieldset>

      <fieldset class="card wide">
        <legend>Criterion</legend>
        <div class="row">
          <select name="criterion">
            <option value="">any</option>
            {% for column in filters.criterion_names %}
              <option value="{{ column }}" {% if column == filters.criterion %}selected{% endif %}>{{ column }}</option>
            {% endfor %}
          </select>
          <select name="op" title="Comparison, used for scored criteria">
            {% for key, symbol in operators.items() %}
              <option value="{{ key }}" {% if key == filters.op %}selected{% endif %}>{{ symbol }}</option>
            {% endfor %}
          </select>
          {% if filters.criterion_type == 'choice' %}
            <select name="value" title="Value, from the selected criterion's options">
              <option value="">any</option>
              {% for option in criterion_options %}
                <option value="{{ option }}" {% if option == filters.option %}selected{% endif %}>{{ option }}</option>
              {% endfor %}
            </select>
          {% else %}
            <input type="text" name="value" placeholder="0.67"
                   value="{% if filters.value is not none %}{{ '%g'|format(filters.value) }}{% endif %}">
          {% endif %}
          <label class="inline" title="Hide offers where the model could not judge this">
            <input type="checkbox" name="exclude_missing" value="1" {% if filters.exclude_missing %}checked{% endif %}>
            remove “cannot tell”
          </label>
        </div>
      </fieldset>

      </div>

      <div class="stack">
      <fieldset class="card columns">
        <legend>Columns</legend>
        <div class="cols-grid">
          {% for column in filters.selectable_columns %}
            <label class="inline"><input type="checkbox" name="cols" value="{{ column }}"
              {% if column in visible %}checked{% endif %}> {{ column }}</label>
          {% endfor %}
        </div>
      </fieldset>
      </div>
    </div>

    <div class="actions">
      <input type="hidden" name="sort" value="{{ filters.sort }}">
      <input type="hidden" name="dir" value="{{ filters.dir }}">
      <button type="submit">Apply</button>
      <a href="/">Reset</a>
    </div>
  </details>
</form>

<p class="count">{{ table.total }} offers · {{ table.offset + 1 }}–{{ table.offset + table.rows|length }}</p>

<table>
  <thead>
    <tr>
      <th><a href="{{ jobs_url(filters, sort='score_total', dir='asc' if filters.sort == 'score_total' and filters.dir == 'desc' else 'desc') }}">Score</a></th>
      <th><a href="{{ jobs_url(filters, sort='decision', dir='asc' if filters.sort == 'decision' and filters.dir == 'desc' else 'desc') }}">Decision</a></th>
      <th><a href="{{ jobs_url(filters, sort='title', dir='asc' if filters.sort == 'title' and filters.dir == 'desc' else 'desc') }}">Title / company</a></th>
      <th><a href="{{ jobs_url(filters, sort='source', dir='asc' if filters.sort == 'source' and filters.dir == 'desc' else 'desc') }}">Board</a></th>
      <th>Ad location</th>
      {% for column in columns %}
        <th class="crit"><a href="{{ jobs_url(filters, sort='crit:' ~ column, dir='asc' if filters.sort == 'crit:' ~ column and filters.dir == 'desc' else 'desc') }}" title="criterion">{{ column }}</a></th>
      {% endfor %}
      {% if 'salary' in visible %}<th>Salary</th>{% endif %}
      {% if 'last_seen' in visible %}<th><a href="{{ jobs_url(filters, sort='last_seen_at', dir='asc' if filters.sort == 'last_seen_at' and filters.dir == 'desc' else 'desc') }}">Last seen</a></th>{% endif %}
      {% if 'run' in visible %}<th><a href="{{ jobs_url(filters, sort='run_started_at', dir='asc' if filters.sort == 'run_started_at' and filters.dir == 'desc' else 'desc') }}">Run</a></th>{% endif %}
      {% if 'feedback' in visible %}<th>Feedback</th>{% endif %}
    </tr>
  </thead>
  <tbody>
  {% for row in table.rows %}
    {% set job = row.job %}
    <tr class="{{ job.decision }}">
      <td class="score">{{ '%.1f'|format(job.score_total or 0) }}</td>
      <td><span class="badge {{ job.decision }}">{{ job.decision|upper }}</span></td>
      <td><a href="/jobs/{{ job.id }}">{{ job.title }}</a><br><small>{{ job.company }}</small></td>
      <td>{{ job.source }}</td>
      <td>{{ job.location_raw or '—' }}</td>
      {% for column in columns %}
        <td class="crit">
          {% if column in row.missing %}<em>—</em>
          {% elif row.answers.get(column) is number %}{{ '%.2f'|format(row.answers[column]) }}
          {% else %}{{ row.answers.get(column, '—') }}{% endif %}
        </td>
      {% endfor %}
      {% if 'salary' in visible %}
        <td>{% if job.salary_min or job.salary_max %}{{ job.salary_min or '?' }}–{{ job.salary_max or '?' }}{% else %}—{% endif %}</td>
      {% endif %}
      {% if 'last_seen' in visible %}<td><small>{{ job.last_seen_at or '—' }}</small></td>{% endif %}
      {% if 'run' in visible %}<td><small>{{ job.run_started_at or '—' }}</small></td>{% endif %}
      {% if 'feedback' in visible %}<td>{% if row.feedback == 'good' %}👍{% elif row.feedback == 'bad' %}👎{% else %}–{% endif %}</td>{% endif %}
    </tr>
  {% else %}
    <tr>
      <td colspan="{{ 5 + columns|length + (1 if 'salary' in visible else 0) + (1 if 'last_seen' in visible else 0) + (1 if 'run' in visible else 0) + (1 if 'feedback' in visible else 0) }}" class="empty">
        <strong>No results.</strong>
        <span class="active-filters">decisions: {{ filters.decisions|join(', ') or 'none' }}{% if filters.source %} · board: {{ filters.source }}{% endif %}{% if filters.text %} · text: “{{ filters.text }}”{% endif %}{% if filters.location %} · location: “{{ filters.location }}”{% endif %}{% if filters.criterion %} · {{ filters.criterion }}{% if filters.option %} = {{ filters.option }}{% elif filters.value is not none %} {{ operators.get(filters.op, filters.op) }} {{ '%g'|format(filters.value) }}{% endif %}{% endif %}{% if filters.exclude_missing %} · without “cannot tell”{% endif %} · run: {{ "every run" if filters.run == 'all' else filters.run }}</span>
        <a href="/jobs?run=all">Widen the search</a> ·
        <a href="/">reset the filters</a>.
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>

<p class="pager">
  {% if table.offset > 0 %}<a href="{{ jobs_url(filters, offset=table.offset - table.limit) }}">‹ previous</a>{% endif %}
  {% if table.offset + table.limit < table.total %}<a href="{{ jobs_url(filters, offset=table.offset + table.limit) }}">next ›</a>{% endif %}
</p>
{% endblock %}
