# Copy to .env (gitignored, chmod 600) and fill in the values you need.
# A real environment variable always wins over this file.

# Telegram bot token (@BotFather). Required when notifications.telegram.enabled is true.
TELEGRAM_BOT_TOKEN=

# Only for engines that declare api_key_env: OPENCODE_API_KEY (jev, opencode_llm).
OPENCODE_API_KEY=
